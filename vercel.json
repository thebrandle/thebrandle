      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/why-your-website-s-user-experience-is-its-greatest-asset/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/why-mobile-first-design-is-crucial-for-modern-websites",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/why-mobile-first-design-is-crucial-for-modern-websites/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/how-to-create-a-website-that-truly-connects-with-your-audience",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/how-to-create-a-website-that-truly-connects-with-your-audience/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/top-web-design-trends-to-watch-in-2024",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/top-web-design-trends-to-watch-in-2024/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/building-trust-online-the-importance-of-testimonials",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/building-trust-online-the-importance-of-testimonials/",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/api/cal-slots",
      "destination": "/api/cal-slots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/thebrandle.framer.website/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/api/visibility-check",
      "destination": "/api/visibility-check"
    },
    {
      "source": "/tools/ai-visibility",
      "destination": "/tools/ai-visibility/index.html"
    },
    {
      "source": "/tools/ai-visibility/",
      "destination": "/tools/ai-visibility/index.html"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/thebrandle.framer.website/index.html"
    }
  ]
