{
  "cleanUrls": false,
  "redirects": [
    { "source": "/thebrandle.framer.website", "destination": "/", "permanent": true },
    { "source": "/thebrandle.framer.website/", "destination": "/", "permanent": true },
    { "source": "/thebrandle.framer.website/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/blog", "destination": "/blog/blog", "permanent": false },
    { "source": "/blog/", "destination": "/blog/blog", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/cal-slots", "destination": "/api/cal-slots" },
    { "source": "/sitemap.xml", "destination": "/thebrandle.framer.website/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/:slug", "destination": "/services/:slug/index.html" },
    { "source": "/(.*)", "destination": "/thebrandle.framer.website/index.html" }
  ]
}
